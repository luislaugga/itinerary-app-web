    {
      "id": "location_ChIJnYs4GxcPYw0RbpxeYgvw1_w",
      "name": "Camping Lo Monte",
      "description": "Large, well-established campground in Torre de la Horadada on the Costa Calida coast, ~255km south of Valencia and ~50km north of Cartagena. 4.3 rating with 3,000+ reviews - modern facilities, pool, gym, sauna, restaurant, clean bathrooms, bungalow rentals. Right at the Mediterranean. Good 1-night stop to break the Valencia -> Cabo de Gata leg and visit Cartagena as a half-day trip.",
      "geo": {
        "main": {
          "lat": 37.8786,
          "lng": -0.7663
        }
