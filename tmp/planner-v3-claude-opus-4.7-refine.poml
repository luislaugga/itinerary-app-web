    {
      "id": "pl_cartagena_town",
      "name": "Cartagena",
      "description": "Ancient Mediterranean port city, founded by the Carthaginians, later a major Roman city. Walkable old town with a visible Roman Theatre, naval history museum, Modernista architecture, and strong seafood tradition. A surprisingly authentic Spanish coastal city - not touristy. Good half-day visit between Lo Monte and Cabo de Gata.",
      "geo": {
        "main": {
          "lat": 37.6056,
          "lng": -0.9863
        }
