    {
      "id": "pl_caceres_oldtown",
      "name": "Caceres old town (Ciudad Monumental)",
      "description": "UNESCO World Heritage walled old town - one of the most complete medieval and Renaissance town centers in Europe. Stork nests on every tower, stone lanes, small plazas, Arab, Moorish, Roman and Jewish layers. Very walkable with kids. The Plaza Mayor just outside the walls is a great dinner stop.",
      "geo": {
        "main": {
          "lat": 39.4746,
          "lng": -6.3717
        }
      },
