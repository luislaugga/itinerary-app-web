          "end_location_id": "location_ChIJOb-oSYoLkEcReQeN952gXzI",
          "note": null,
          "default_route_id": "day_2026-07-10_drive_fast",
          "routes": [
            {
              "id": "day_2026-07-10_drive_fast",
              "variant": "fastest",
              "constraints": [],
              "note": "fast route option",
              "distance_km": 587,
              "duration_minutes": 390,
              "external_maps": {
                "google_maps": "https://www.google.com/maps/dir/?api=1&origin=Royat%2C%20Clermont-Ferrand&destination=Zurich&travelmode=driving&waypoints=Clermont-Ferrand%7CLyon%7CGeneva",
                "apple_maps": null,
                "abrp": null
              },
              "waypoint_locations": [
                "location_ChIJBY97mEIC90cRQrkYmA9atpY",
                "location_ChIJKzb2KV7r9EcR8kkVbSVYWYY",
                "location_ChIJ7SK7SyRljEcRpIwv4wbyYQE"
              ]
            },
            {
              "id": "day_2026-07-10_drive_scenic",
              "variant": "scenic",
              "constraints": [],
              "note": "scenic route option",
              "distance_km": 642.5,
              "duration_minutes": 478,
              "external_maps": {
                "google_maps": "https://www.google.com/maps/dir/?api=1&origin=Royat%2C%20Clermont-Ferrand&destination=Zurich&travelmode=driving&waypoints=Puy%20de%20D%C3%B4me%2C%20Auvergne%7CLyon%7CGeneva",
                "apple_maps": null,
                "abrp": null
              },
              "waypoint_locations": [
                "location_ChIJOY_uB94Q90cROtnHbERG2Ks",
                "location_ChIJKzb2KV7r9EcR8kkVbSVYWYY",
                "location_ChIJ7SK7SyRljEcRpIwv4wbyYQE"
              ]
            },
            {
              "id": "day_2026-07-10_drive_no_highways",
              "variant": "custom",
              "constraints": [
                "avoid_highways"
              ],
              "note": "no highways route option",
              "distance_km": 704.4,
              "duration_minutes": 468,
              "external_maps": {
                "google_maps": "https://www.google.com/maps/dir/?api=1&origin=Royat%2C%20Clermont-Ferrand&destination=Zurich&travelmode=driving&waypoints=Clermont-Ferrand%7CLyon%7CGeneva",
                "apple_maps": null,
                "abrp": null
              },
              "waypoint_locations": [
                "location_ChIJYWnFr90b90cRJ5I-rvcCIHc",
                "location_ChIJKzb2KV7r9EcR8kkVbSVYWYY",
                "location_ChIJ7SK7SyRljEcRpIwv4wbyYQE"
              ]
            }
          ]
        }
      ]
    }
  ],
  "note": "v3 update: Outbound compressed Provence to 2 nights and added a 2-night Languedoc coast base at Marseillan/Sete, plus a 1-night stop at Torre de la Horadada (Lo Monte) to break the Valencia-Cabo de Gata leg via Elche's palmeral. Drives kept 100-380km. Return now skips the SW Portugal coast (Sao Miguel) entirely and routes through inland Portugal/Spain: Monte Gordo -> Evora -> Caceres (UNESCO old town + Monfrague + Trujillo) -> Salamanca. New hidden-gem food and playground stops added throughout: Parc Jouvet (Valence playground), La Fabrique a gout-the (Marseillan), Chez Alphonse ice cream (Sete), Glaces de Maitre (Arles), Olivier Bajard (Collioure), Palmeral de Elche (UNESCO palm grove + shaded playground), Tiramisu-Gelateria (Cartagena), Borona Bistro (Caceres), Dos Orillas (Trujillo), Monfrague National Park."
}
  </document>

  <document title="Itinerary Schema" syntax="json">
    {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/itinerary.schema.json",
  "title": "Itinerary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version_id",
    "locations",
    "days"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "description": "Version of the itinerary schema format"
    },
    "version_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier for this specific itinerary version"
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "location.schema.json"
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "day.schema.json"
      }
    },
    "note": {
      "type": ["string", "null"]
    }
  }
}
  </document>

  <document title="Day Schema" syntax="json">
    {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/day.schema.json",
  "title": "Itinerary Day",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "date",
    "wake_location_id",
    "sleep_location_id",
    "base",
    "movements"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "wake_location_id": {
      "$ref": "#/$defs/locationId"
    },
    "sleep_location_id": {
      "$ref": "#/$defs/locationId"
    },
    "note": {
      "type": ["string", "null"]
    },
    "base": {
      "$ref": "#/$defs/base"
    },
    "movements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/movement"
      }
    }
  },
  "$defs": {
    "locationId": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor",
        "nearby_locations"
      ],
      "properties": {
        "anchor": {
          "type": "string",
          "enum": ["wake", "sleep", "custom"]
        },
        "anchor_location_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "nearby_locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locationId"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "anchor": {
                "const": "custom"
              }
            },
            "required": ["anchor"]
          },
          "then": {
            "required": ["anchor_location_id"],
            "properties": {
              "anchor_location_id": {
                "$ref": "#/$defs/locationId"
              }
            }
          }
        }
      ]
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "start_location_id",
        "end_location_id",
        "routes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["car", "walk", "bike"]
        },
        "start_location_id": {
          "$ref": "#/$defs/locationId"
        },
        "end_location_id": {
          "$ref": "#/$defs/locationId"
        },
        "note": {
          "type": ["string", "null"]
        },
        "default_route_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/route"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "variant",
        "constraints",
        "waypoint_locations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "enum": ["fastest", "scenic", "custom"]
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/routeConstraint"
          }
        },
        "note": {
          "type": ["string", "null"]
        },
        "distance_km": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "duration_minutes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "external_maps": {
          "anyOf": [
            {
              "$ref": "#/$defs/externalMaps"
            },
            {
              "type": "null"
            }
          ]
        },
        "waypoint_locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locationId"
          }
        }
      }
    },
    "routeConstraint": {
      "type": "string",
      "enum": ["avoid_highways"]
    },
    "externalMaps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "google_maps": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "apple_maps": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "abrp": {
          "type": ["string", "null"],
          "format": "uri"
        }
      }
    }
  }
}
  </document>

  <document title="Location Schema" syntax="json">
    {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/location.schema.json",
  "title": "Location",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "geo", "types"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": ["string", "null"]
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main"],
      "properties": {
        "main": {
          "$ref": "#/$defs/latLng"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["northeast", "southwest"],
          "properties": {
            "northeast": {
              "$ref": "#/$defs/latLng"
            },
            "southwest": {
              "$ref": "#/$defs/latLng"
            }
          }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": ["string", "null"]
        },
        "formatted_address": {
          "type": ["string", "null"]
        },
        "locality": {
          "type": ["string", "null"]
        },
        "region": {
          "type": ["string", "null"]
        },
        "postcode": {
          "type": ["string", "null"]
        },
        "country": {
          "type": ["string", "null"]
        }
      }
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/locationType"
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": ["string", "null"]
        },
        "popularity": {
          "type": ["string", "null"],
          "enum": ["hidden_gem", "known_place", "touristic", null]
        }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": ["string", "null"]
        },
        "source": {
          "type": ["string", "null"]
        }
      }
    },
    "provider_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "google_maps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["place_id", "url"],
          "properties": {
            "place_id": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "rating": {
              "type": ["number", "null"],
              "minimum": 0
            }
          }
        },
        "foursquare": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fsq_id"],
          "properties": {
            "fsq_id": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": ["string", "null"],
              "format": "uri"
            }
          }
        },
        "apple_maps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["place_id"],
          "properties": {
            "place_id": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": ["string", "null"],
              "format": "uri"
            }
          }
        }
      }
    },
    "location_details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "available": {
              "type": ["boolean", "null"]
            },
            "options": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/parkingOption"
              }
            },
            "notes": {
              "type": ["string", "null"]
            }
          }
        },
        "campground": {
          "type": "object",
          "additionalProperties": false,
          "required": ["camping_styles", "surface", "shade"],
          "properties": {
            "camping_styles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/campingStyle"
              }
            },
            "surface": {
              "$ref": "#/$defs/campgroundSurface"
            },
            "shade": {
              "$ref": "#/$defs/campgroundShade"
            },
            "sanitary": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hot_showers": {
                  "type": ["boolean", "null"]
                },
                "clean_toilets": {
                  "type": ["boolean", "null"]
                }
              }
            },
            "quiet_hours": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enforced": {
                  "type": ["boolean", "null"]
                },
                "starts_at": {
                  "type": ["string", "null"],
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                }
              }
            },
            "amenities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/campgroundAmenity"
              }
            },
            "notes": {
              "type": ["string", "null"]
            }
          }
        },
        "food_drinks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "service_types": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/foodDrinkServiceType"
              }
            },
            "cuisines": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "dietary_options": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/dietaryOption"
              }
            },
            "price_level": {
              "type": ["string", "null"],
              "enum": ["budget", "moderate", "upscale", null]
            },
            "notes": {
              "type": ["string", "null"]
            }
          }
        },
        "family": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "good_for_children": {
              "type": ["boolean", "null"]
            },
            "amenities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/familyAmenity"
              }
            },
            "notes": {
              "type": ["string", "null"]
            }
          }
        },
        "electric_vehicle_charging": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "network": {
              "type": ["string", "null"]
            },
            "charger_types": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/chargerType"
              }
            },
            "power_kw": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "notes": {
              "type": ["string", "null"]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "latLng": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng"],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "locationType": {
      "type": "string",
      "enum": [
        "restaurant",
        "ice_cream_shop",
        "bakery",
        "coffee_shop",
        "bar",
        "supermarket",
        "grocery_store",
        "store",
        "market",
        "hotel",
        "campground",
        "beach",
        "park",
        "nature_reserve",
        "hiking_area",
        "landmark",
        "historical_landmark",
        "cultural_landmark",
        "viewpoint",
        "visitor_center",
        "wildlife_refuge",
        "city",
        "town",
        "village",
        "region",
        "locality",
        "neighborhood",
        "address",
        "route",
        "electric_vehicle_charging_station",
        "parking"
      ]
    },
    "parkingOption": {
      "type": "string",
      "enum": ["on_site", "free", "paid", "street", "garage", "valet"]
    },
    "campingStyle": {
      "type": "string",
      "enum": ["tent", "campervan", "motorhome", "caravan", "glamping"]
    },
    "campgroundSurface": {
      "type": "string",
      "enum": ["soft_pitch", "hard_pitch", "mixed", "unknown"]
    },
    "campgroundShade": {
      "type": "string",
      "enum": ["none", "partial", "good", "unknown"]
    },
    "campgroundAmenity": {
      "type": "string",
      "enum": [
        "playground",
        "pool",
        "laundry",
        "bike_rental",
        "wifi",
        "camp_store",
        "restaurant",
        "ev_charging"
      ]
    },
    "foodDrinkServiceType": {
      "type": "string",
      "enum": [
        "breakfast",
        "brunch",
        "lunch",
        "dinner",
        "coffee",
        "snacks",
        "drinks"
      ]
    },
    "dietaryOption": {
      "type": "string",
      "enum": ["vegetarian", "vegan", "gluten_free"]
    },
    "familyAmenity": {
      "type": "string",
      "enum": [
        "playground",
        "kids_menu",
        "baby_changing",
        "family_restrooms",
        "babysitting"
      ]
    },
    "chargerType": {
      "type": "string",
      "enum": ["supercharger", "ccs", "type2", "chademo"]
    }
  }
}
  </document>

  <document title="Refine Request Schema" syntax="yaml">
    schema_name: Refine Request
description: >
  Lean YAML payload exported from the planning app. It keeps location feedback
  separate from the base itinerary and includes a day-by-day trip overview for
  the edited draft.
file_format: YAML
lifecycle: exported_feedback
required:
  - schema_version
  - itinerary
  - location_feedback
  - trip_overview
properties:
  schema_version:
    type: string
  itinerary:
    type: object
    required:
      - version_id
      - file
    properties:
      version_id: { type: string }
      file: { type: string }
  location_feedback:
    type: array
    description: User reactions and optional notes for specific locations.
    items:
      type: object
      required:
        - location_id
        - vote
      properties:
        location_id: { type: string }
        vote:
          type: string
          enum: [like, upvote, unvote, remove]
        note: { type: string }
  trip_overview:
    type: array
    description: Full edited day-by-day overview, primarily where each day sleeps.
    items:
      type: object
      required:
        - day_id
        - day_number
        - date
        - wake_location_id
        - sleep_location_id
        - locked
      properties:
        day_id: { type: string }
        day_number: { type: integer }
        date: { type: string }
        wake_location_id: { type: string }
        sleep_location_id: { type: string }
        locked: { type: boolean }
        note: { type: string }
  </document>
</prompt>
