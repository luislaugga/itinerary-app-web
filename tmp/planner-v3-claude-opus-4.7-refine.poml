    {
      "id": "pl_monfrague_np",
      "name": "Parque Nacional de Monfrague",
      "description": "Spain's most important raptor reserve - Griffon vultures, Egyptian vultures, black vultures, Bonelli's eagles, Spanish imperial eagles, black storks. The Salto del Gitano viewpoint gives eye-level views of nesting vultures across the Tagus gorge. A genuine wildlife-watching experience kids remember. 30km from Caceres - makes a half-day trip or a waypoint on the way to Salamanca.",
      "geo": {
        "main": {
          "lat": 39.8583,
          "lng": -6.0475
        }
