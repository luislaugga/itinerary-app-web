{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/day.schema.json",
  "title": "Itinerary Day",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "date",
    "wake_location_id",
    "sleep_location_id",
    "base",
    "movements"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "wake_location_id": {
      "$ref": "#/$defs/locationId"
    },
    "sleep_location_id": {
      "$ref": "#/$defs/locationId"
    },
    "note": {
      "type": ["string", "null"]
    },
    "booked": {
      "type": "boolean",
      "description": "True when the overnight/base accommodation for this day is booked and should be treated as fixed."
    },
    "base": {
      "$ref": "#/$defs/base"
    },
    "movements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/movement"
      }
    }
  },
  "$defs": {
    "locationId": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor",
        "nearby_locations"
      ],
      "properties": {
        "anchor": {
          "type": "string",
          "enum": ["wake", "sleep", "custom"]
        },
        "anchor_location_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "nearby_locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locationId"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "anchor": {
                "const": "custom"
              }
            },
            "required": ["anchor"]
          },
          "then": {
            "required": ["anchor_location_id"],
            "properties": {
              "anchor_location_id": {
                "$ref": "#/$defs/locationId"
              }
            }
          }
        }
      ]
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "start_location_id",
        "end_location_id",
        "routes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["car", "walk", "bike"]
        },
        "start_location_id": {
          "$ref": "#/$defs/locationId"
        },
        "end_location_id": {
          "$ref": "#/$defs/locationId"
        },
        "note": {
          "type": ["string", "null"]
        },
        "default_route_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/route"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "variant",
        "constraints",
        "waypoint_locations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "enum": ["fastest", "scenic", "custom"]
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/routeConstraint"
          }
        },
        "note": {
          "type": ["string", "null"]
        },
        "distance_km": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "duration_minutes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "external_maps": {
          "anyOf": [
            {
              "$ref": "#/$defs/externalMaps"
            },
            {
              "type": "null"
            }
          ]
        },
        "waypoint_locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locationId"
          }
        }
      }
    },
    "routeConstraint": {
      "type": "string",
      "enum": ["avoid_highways"]
    },
    "externalMaps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "google_maps": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "apple_maps": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "abrp": {
          "type": ["string", "null"],
          "format": "uri"
        }
      }
    }
  }
}
